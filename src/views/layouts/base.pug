doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title= title ? `${title} - SkillSwap` : 'SkillSwap'
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap')
    link(rel='stylesheet' href='/css/app.css')
    block head
  body(class=bodyClass || 'bg-[#F4F7FC] text-slate-800 antialiased min-h-screen flex flex-col')
    block header
      if !hideNavbar
        include ../partials/navbar
    block flash
      include ../partials/flash
    block content
    block footer
      if !hideFooter
        include ../partials/footer
    block scripts
