extends ../layouts/base

block content
  main.flex-1.flex.flex-col.overflow-y-auto.px-10.py-8
    .flex.items-center.gap-3.mb-6
      a(aria-label='Go back' class='text-slate-800 hover:text-slate-600 transition-colors p-1 -ml-1' href='/suggestions')
        svg(class='w-5 h-5 stroke-current fill-none stroke-[2.5]' viewBox='0 0 24 24')
          path(d='M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18' stroke-linecap='round' stroke-linejoin='round')
      h1.text-lg.font-bold.text-slate-900 Submit a Report

    - var selectedType = (formData && formData.type) ? formData.type : 'user'
    - var selectedReportedUser = (formData && formData.reportedUserId) ? String(formData.reportedUserId) : ''

    form.max-w-3xl.flex.flex-col.space-y-6(method='POST' action='/reports')
      input(type='hidden' name='_csrf' value=csrfToken)

      div
        h2.text-base.font-bold.text-slate-900.mb-1 Report an Issue or User
        p.text-xs.text-slate-500 Help us keep SkillSwap safe and working smoothly.

      fieldset.space-y-3(data-purpose='report-reasons')
        legend.sr-only Report type
        each opt in reportTypes
          label(class='flex items-center justify-between px-5 py-3.5 bg-white border border-slate-200 rounded-xl cursor-pointer hover:border-slate-300 transition-all')
            span.text-xs.font-semibold.text-slate-800= opt.label
            input(class='w-4 h-4 text-blue-600 border-slate-300 focus:ring-blue-500' name='type' type='radio' value=opt.value checked=(selectedType === opt.value))

      div
        label(class='block text-xs font-bold uppercase text-slate-500 mb-1.5' for='reportedUserId') Related User (Optional)
        select#reportedUserId(
          class='w-full bg-white border border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500'
          name='reportedUserId'
        )
          option(value='') None / General issue
          each peer in (reportTargetUsers || [])
            option(value=peer.id selected=(selectedReportedUser === String(peer.id)))= peer.name
        if errors && errors.reportedUserId
          p.text-xs.text-rose-600.mt-1= errors.reportedUserId

      div
        label(class='block text-xs font-bold uppercase text-slate-500 mb-1.5' for='subject') Subject
        input#subject(
          class=`w-full bg-white border border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 ${errors && errors.subject ? 'input-error' : ''}`
          name='subject'
          type='text'
          placeholder='Short summary of the issue'
          value=(formData && formData.subject ? formData.subject : '')
          required
        )
        if errors && errors.subject
          p.text-xs.text-rose-600.mt-1= errors.subject

      div
        label(class='block text-xs font-bold uppercase text-slate-500 mb-1.5' for='description') Details
        textarea#description(
          class=`w-full bg-white border border-slate-300 rounded-xl p-4 text-sm text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 resize-none transition-colors ${errors && errors.description ? 'input-error' : ''}`
          name='description'
          placeholder='Describe what happened...'
          rows='6'
          required
        )= (formData && formData.description ? formData.description : '')
        if errors && errors.description
          p.text-xs.text-rose-600.mt-1= errors.description

      .pt-2
        button(
          class='w-full py-3.5 bg-[#FDE7E7] hover:bg-[#FCD8D8] text-[#861919] font-bold text-sm rounded-full transition-colors tracking-wide cursor-pointer'
          type='submit'
        ) Submit Report

    if myReports && myReports.length
      section.max-w-3xl.mt-10.space-y-3(data-purpose='my-reports')
        h2.text-base.font-bold.text-slate-900 Your Submitted Reports
        each item in myReports
          article(class='bg-white rounded-xl border border-slate-200 px-5 py-4 flex items-center justify-between gap-4')
            .min-w-0
              p.text-sm.font-semibold.text-slate-900.truncate= item.subject
              p(class='text-xs text-slate-500 mt-0.5')
                span.capitalize= item.type
                if item.reportedUserName
                  = ` • User: ${item.reportedUserName}`
                = ` • ${item.dateLabel}`
            span(class='px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 capitalize shrink-0')= item.status.replace('_', ' ')
