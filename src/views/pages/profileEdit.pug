extends ../layouts/base

block content
  main(class='w-full max-w-[1360px] mx-auto flex-grow flex flex-col justify-between p-6 sm:p-10 md:p-12' data-purpose='edit-profile-wrapper')
    .w-full.space-y-7
      header.flex.items-center.justify-between.pt-1.pb-2(data-purpose='navigation-header')
        h1(class='text-[26px] font-extrabold text-[#111827] tracking-tight') Edit Profile
        a(class='text-[#0057C2] text-lg font-semibold hover:underline' href='/profile' data-purpose='done-button') Done

      section.flex.flex-col.items-center.justify-center.pt-1.pb-4(data-purpose='profile-avatar-container')
        .relative.w-28.h-28.rounded-full.overflow-hidden.bg-white.shadow-sm.border.border-slate-100.flex.items-center.justify-center.mb-3
          if profile.avatarPath
            img.w-full.h-full.object-cover.object-top(alt='Profile Avatar' src=`/${profile.avatarPath}`)
          else
            span(class='text-3xl font-extrabold text-[#0057C2]')= profile.name ? profile.name.charAt(0).toUpperCase() : 'U'

        form#avatarForm.flex.flex-col.items-center.gap-3(method='POST' action='/profile/avatar' enctype='multipart/form-data')
          input(type='hidden' name='_csrf' value=csrfToken)
          input#avatarInput(
            class='text-xs text-slate-600 file:mr-3 file:py-2 file:px-4 file:rounded-full file:border file:border-[#0057C2] file:text-xs file:font-semibold file:bg-white file:text-[#0057C2] hover:file:bg-blue-50 cursor-pointer'
            type='file'
            name='avatar'
            accept='image/jpeg,image/png,image/webp'
            required
          )
          button(class='text-[#0057C2] font-semibold text-[15px] hover:underline cursor-pointer focus:outline-none' data-purpose='change-photo-action' type='submit') Upload Profile Photo
          p.text-xs.text-slate-400 JPEG, PNG, or WebP (max 5 MB, resized to 400x400)

      form#profileEditForm.space-y-6(method='POST' action='/profile/edit' data-purpose='profile-edit-form' novalidate)
        input(type='hidden' name='_csrf' value=csrfToken)

        .space-y-2
          label(class='block text-[13px] font-bold tracking-wider text-slate-500 uppercase' for='name') FULL NAME
          input#name(
            class=`w-full px-5 py-3.5 bg-white border border-slate-200 rounded-2xl text-slate-800 text-base focus:ring-2 focus:ring-[#0057C2] focus:border-transparent outline-none transition duration-150 shadow-sm ${errors && errors.name ? 'input-error' : ''}`
            name='name'
            type='text'
            value=(formData && formData.name !== undefined ? formData.name : profile.name)
            required
          )
          if errors && errors.name
            p.text-xs.text-rose-600.mt-1= errors.name

        .space-y-2
          .flex.items-center.justify-between
            label(class='block text-[13px] font-bold tracking-wider text-slate-500 uppercase' for='bio') BIO
            span#bio-counter.text-xs.text-slate-400.font-medium= `${((formData && formData.bio !== undefined ? formData.bio : profile.bio) || '').length} / 1000`
          textarea#bio(
            class='w-full px-5 py-3.5 bg-white border border-slate-200 rounded-2xl text-slate-800 text-sm focus:ring-2 focus:ring-[#0057C2] focus:border-transparent outline-none transition duration-150 shadow-sm'
            name='bio'
            rows='4'
            maxlength='1000'
            placeholder='Introduce yourself, your experience, and what you want to learn or teach.'
          )= (formData && formData.bio !== undefined ? formData.bio : profile.bio) || ''
          if errors && errors.bio
            p.text-xs.text-rose-600.mt-1= errors.bio

        .space-y-3
          .flex.items-center.justify-between
            label(class='block text-[13px] font-bold tracking-wider text-slate-500 uppercase') PROJECT LINKS
            button#addProjectLinkBtn(class='text-xs font-semibold text-[#0057C2] hover:underline' type='button') + Add another link
          - var linksToRender = (formData && formData.projectLinks && formData.projectLinks.length) ? formData.projectLinks : ['']
          #projectLinksContainer(class='space-y-2.5')
            each linkUrl in linksToRender
              .flex.items-center.gap-2.project-link-row
                input(
                  class='w-full px-4 py-3 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm focus:ring-2 focus:ring-[#0057C2] focus:border-transparent outline-none transition duration-150 shadow-sm'
                  name='projectLinks'
                  type='url'
                  placeholder='https://github.com/username/project'
                  value=linkUrl
                )
                button.remove-project-link(class='px-3 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 rounded-lg' type='button') Remove
          if errors && errors.projectLinks
            p.text-xs.text-rose-600.mt-1= errors.projectLinks

        div(class='pt-1 space-y-2.5')
          .flex.items-center.justify-between
            span(class='block text-[15px] font-bold text-slate-700') Skills I can teach
            a(class='text-xs font-semibold text-[#0057C2] hover:underline' href='/skills') Manage skills
          div(class='flex flex-wrap items-center gap-2.5')
            each skill in profile.offerSkills
              span(class='inline-flex items-center bg-[#DCF7E9] text-[#0E7A4A] px-4 py-1.5 rounded-full text-sm font-semibold')= skill.skillName
            if !profile.offerSkills.length
              span.text-xs.text-slate-400 None yet

        div(class='pt-1 space-y-2.5')
          .flex.items-center.justify-between
            span(class='block text-[15px] font-bold text-slate-700') Skills I want to learn
            a(class='text-xs font-semibold text-[#0057C2] hover:underline' href='/skills') Manage skills
          div(class='flex flex-wrap items-center gap-2.5')
            each skill in profile.wantSkills
              span(class='inline-flex items-center bg-[#E1EDFF] text-[#185BCE] px-4 py-1.5 rounded-full text-sm font-semibold')= skill.skillName
            if !profile.wantSkills.length
              span.text-xs.text-slate-400 None yet

        .w-full.pt-8.pb-4(data-purpose='save-button-container')
          button(
            class='w-full bg-[#0057C2] hover:bg-[#004bb0] active:bg-[#004199] text-white font-semibold text-lg py-4 rounded-full shadow-sm transition-colors duration-200 flex items-center justify-center cursor-pointer'
            data-purpose='save-changes-button'
            type='submit'
          ) Save Changes

block scripts
  script(src='/js/profile.js')
