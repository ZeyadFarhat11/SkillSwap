extends ../layouts/base

block content
  main(class='flex-1 flex flex-col min-w-0 bg-[#F4F7FB]' data-purpose='chat-history-main')
    .max-w-7xl.w-full.mx-auto.px-8.pt-7.pb-12.flex-1
      header.flex.items-center.justify-between.mb-8(data-purpose='header-section')
        h1(class='text-[22px] font-bold text-slate-900 tracking-tight') Messages

      section#conversationsList(aria-label='Recent Conversations' class='space-y-3.5')
        if !conversations || !conversations.length
          .bg-white.rounded-xl.border.border-slate-200.px-6.py-8.text-center
            p.text-sm.font-medium.text-slate-600 No conversations yet.
            p.text-xs.text-slate-400.mt-1
              | Visit a user's profile or browse
              a(class='text-[#0062D2] font-semibold hover:underline ml-1' href='/requests') Swap Requests
              |  to start messaging.
        else
          each thread in conversations
            a(
              class='bg-white rounded-xl border border-[#E7EDF4] px-5 py-4 flex items-center justify-between shadow-[0_1px_2px_rgba(0,0,0,0.02)] hover:border-slate-300 transition-all no-underline'
              href=`/messages/${thread.userId}`
              data-user-id=thread.userId
            )
              .flex.items-center.gap-4.min-w-0
                .relative.flex-shrink-0
                  div(class='w-12 h-12 rounded-full bg-[#e9f0fc] text-[#0062D2] flex items-center justify-center font-bold text-base')= thread.name.charAt(0).toUpperCase()
                  span(
                    class=`absolute bottom-0.5 right-0.5 w-3 h-3 bg-[#10B981] border-2 border-white rounded-full ${thread.online ? '' : 'hidden'}`
                    title='Online'
                    data-online-dot='true'
                  )
                .min-w-0
                  h2(class='text-[14.5px] font-bold text-slate-900 leading-snug')= thread.name
                  p(class='text-[13px] text-slate-500 truncate mt-0.5' data-last-message='true')= thread.lastMessage
              .flex-shrink-0.text-right.ml-4
                span(class='text-[12px] font-normal text-slate-400' data-time-ago='true')= thread.timeAgo

block scripts
  script(src='/socket.io/socket.io.js')
  script(src='/js/chat.js')
