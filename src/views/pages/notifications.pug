extends ../layouts/base

block content
  main.flex-1.px-8.py-7.overflow-y-auto.max-w-5xl
    .flex.items-center.justify-between.pb-6
      h1.text-xl.font-bold.text-slate-900.tracking-tight Notifications
      if notifications && notifications.length
        form(method='POST' action='/notifications/clear')
          input(type='hidden' name='_csrf' value=csrfToken)
          button(
            class='text-sm font-medium text-[#1E6FE9] hover:text-blue-700 transition-colors cursor-pointer'
            type='submit'
          ) Clear All

    div(class='space-y-3.5 w-full')
      if !notifications || !notifications.length
        .bg-white.border.rounded-2xl.px-6.py-10.text-center(class='border-slate-200/80')
          p.text-sm.font-semibold.text-slate-700 You are all caught up!
          p.text-xs.text-slate-400.mt-1 New messages, swap requests, sessions, and reviews will appear here.
      else
        each item in notifications
          a(
            class='bg-white border border-slate-200/80 rounded-2xl p-4 flex items-center gap-4 transition-all hover:border-slate-300 no-underline'
            data-purpose='notification-item'
            href=item.href
          )
            if item.category === 'message'
              .w-10.h-10.rounded-xl.bg-blue-50.flex.items-center.justify-center.shrink-0
                svg(class='w-5 h-5 text-[#1E6FE9]' fill='none' stroke='currentColor' stroke-width='1.8' viewBox='0 0 24 24')
                  path(d='M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z' stroke-linecap='round' stroke-linejoin='round')
            else if item.category === 'session'
              .w-10.h-10.rounded-xl.bg-amber-50.flex.items-center.justify-center.shrink-0
                svg(class='w-5 h-5 text-amber-500' fill='none' stroke='currentColor' stroke-width='1.8' viewBox='0 0 24 24')
                  path(d='M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' stroke-linecap='round' stroke-linejoin='round')
            else if item.category === 'rating'
              .w-10.h-10.rounded-xl.bg-emerald-50.flex.items-center.justify-center.shrink-0
                svg(class='w-5 h-5 text-emerald-600' fill='none' stroke='currentColor' stroke-width='1.8' viewBox='0 0 24 24')
                  path(d='M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z' stroke-linecap='round' stroke-linejoin='round')
            else
              .w-10.h-10.rounded-xl.bg-blue-50.flex.items-center.justify-center.shrink-0
                svg(class='w-5 h-5 text-[#1E6FE9]' fill='none' stroke='currentColor' stroke-width='1.8' viewBox='0 0 24 24')
                  path(d='M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' stroke-linecap='round' stroke-linejoin='round')
            .flex.flex-col.min-w-0
              p.text-sm.font-semibold.text-slate-800= item.title
              if item.detail
                p(class='text-xs text-slate-500 truncate mt-0.5')= item.detail
              span(class='text-xs text-slate-400 mt-0.5')= item.timeAgo
