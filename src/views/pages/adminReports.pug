extends ../layouts/base

block content
  div(class='flex-1 flex flex-col min-w-0')
    include ../partials/adminTopbar

    main(class='flex-1 p-8 space-y-7 max-w-[1500px] w-full mx-auto')
      div(data-purpose='page-header')
        h1(class='text-2xl font-bold tracking-tight text-[#0F172A]') Reports Management
        p(class='text-sm text-[#64748B] mt-1') Review user, message, and bug reports and update their status.

      section(class='grid grid-cols-1 sm:grid-cols-3 gap-5' data-purpose='metrics-row')
        div(class='bg-white rounded-xl p-5 border border-[#EDF2F7] shadow-sm flex flex-col items-center justify-center text-center')
          span(class='text-[11px] font-bold text-[#8A99AD] tracking-wider uppercase') OPEN REPORTS
          span(class='text-3xl font-extrabold text-[#0F172A] my-1')= summary.open
        div(class='bg-white rounded-xl p-5 border border-[#EDF2F7] shadow-sm flex flex-col items-center justify-center text-center')
          span(class='text-[11px] font-bold text-[#8A99AD] tracking-wider uppercase') IN REVIEW
          span(class='text-3xl font-extrabold text-[#0F172A] my-1')= summary.inReview
        div(class='bg-white rounded-xl p-5 border border-[#EDF2F7] shadow-sm flex flex-col items-center justify-center text-center')
          span(class='text-[11px] font-bold text-[#8A99AD] tracking-wider uppercase') RESOLVED
          span(class='text-3xl font-bold text-[#0F172A] my-1')= summary.resolved

      section(class='bg-white rounded-2xl border border-[#EDF2F7] shadow-sm overflow-hidden p-6' data-purpose='reports-table-section')
        div(class='mb-6')
          h2(class='text-lg font-bold text-[#0F172A]') All Reports
          p(class='text-xs text-[#64748B] mt-0.5') Search reports and update their moderation status.

        form(class='flex flex-col sm:flex-row items-center gap-3 mb-6' method='GET' action='/admin/reports' data-purpose='reports-search-form')
          div(class='relative flex-1 w-full sm:max-w-md')
            span(class='absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#94A3B8]')
              svg(class='w-3.5 h-3.5' fill='none' stroke='currentColor' viewBox='0 0 24 24')
                path(d='M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z' stroke-linecap='round' stroke-linejoin='round' stroke-width='2')
            input(
              class='w-full pl-9 pr-4 py-2 bg-white border border-[#E2E8F0] rounded-lg text-xs text-[#334155] placeholder-[#94A3B8] focus:outline-none focus:ring-1 focus:ring-[#0055D6] focus:border-[#0055D6] transition'
              name='q'
              placeholder='Search subject, submitter, or details...'
              type='text'
              value=(filters && filters.q ? filters.q : '')
              data-table-search-target='adminReportsTable'
              aria-label='Search reports'
            )
          div(class='w-full sm:w-40')
            select(class='w-full py-2 pl-3 pr-8 bg-white border border-[#E2E8F0] rounded-lg text-xs text-[#475569] focus:outline-none focus:ring-1 focus:ring-[#0055D6] focus:border-[#0055D6]' name='status')
              option(value='' selected=(!filters || !filters.status)) All Status
              option(value='open' selected=(filters && filters.status === 'open')) Open
              option(value='in_review' selected=(filters && filters.status === 'in_review')) In Review
              option(value='resolved' selected=(filters && filters.status === 'resolved')) Resolved
          button(class='px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition cursor-pointer' type='submit') Search
          if filters && (filters.q || filters.status)
            a(class='text-xs font-semibold text-[#0055D6] hover:underline px-2' href='/admin/reports') Clear

        .overflow-x-auto
          table#adminReportsTable(class='w-full text-left border-collapse')
            thead
              tr(class='bg-[#F8FAFC] border-b border-[#F1F5F9]')
                th(class='py-3 px-4 text-[11px] font-bold text-[#64748B] tracking-wider uppercase') SUBJECT
                th(class='py-3 px-4 text-[11px] font-bold text-[#64748B] tracking-wider uppercase') TYPE
                th(class='py-3 px-4 text-[11px] font-bold text-[#64748B] tracking-wider uppercase') SUBMITTER
                th(class='py-3 px-4 text-[11px] font-bold text-[#64748B] tracking-wider uppercase') STATUS
                th(class='py-3 px-4 text-[11px] font-bold text-[#64748B] tracking-wider uppercase text-right') UPDATE
            tbody(class='divide-y divide-[#F1F5F9] text-xs')
              if !reports || !reports.length
                tr
                  td(class='py-6 px-4 text-center text-slate-400' colspan='5') No reports found.
              else
                each report in reports
                  tr(
                    class='hover:bg-[#FBFDFF] transition-colors'
                    data-search-row='true'
                    data-search-text=`${report.subject} ${report.description} ${report.type} ${report.submitterName} ${report.reportedUserName || ''} ${report.status}`
                  )
                    td(class='py-4 px-4')
                      .font-bold(class='text-[#0F172A]')= report.subject
                      div(class='text-[11px] text-[#94A3B8]')= report.description
                      if report.reportedUserName
                        div(class='text-[11px] text-rose-500 mt-0.5')= `Reported user: ${report.reportedUserName}`
                    td(class='py-4 px-4 text-[#475569] capitalize')= report.type
                    td(class='py-4 px-4 text-[#475569]')= report.submitterName
                    td(class='py-4 px-4')
                      if report.status === 'resolved'
                        span(class='inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-[#E6F8F0] text-[#059669] capitalize')= report.status.replace('_', ' ')
                      else if report.status === 'in_review'
                        span(class='inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-[#E4EFFF] text-[#1B5ECC] capitalize')= report.status.replace('_', ' ')
                      else
                        span(class='inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-[#FEF3C7] text-[#D97706] capitalize')= report.status.replace('_', ' ')
                    td(class='py-4 px-4 text-right')
                      form(class='inline-flex items-center gap-2' method='POST' action=`/admin/reports/${report.id}/status`)
                        input(type='hidden' name='_csrf' value=csrfToken)
                        select(class='py-1 px-2 rounded border border-slate-200 text-xs' name='status')
                          option(value='open' selected=(report.status === 'open')) Open
                          option(value='in_review' selected=(report.status === 'in_review')) In Review
                          option(value='resolved' selected=(report.status === 'resolved')) Resolved
                        button(class='text-[#0055D6] hover:underline font-bold text-xs cursor-pointer' type='submit') Save
                tr(class='hidden' data-empty-search-row='true')
                  td(class='py-6 px-4 text-center text-slate-400' colspan='5') No matching reports found.

block scripts
  script(src='/js/adminSearch.js')
