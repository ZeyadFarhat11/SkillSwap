extends ../layouts/base

block content
  .flex-1.flex.flex-col.min-w-0
    header(class='h-20 bg-white/70 backdrop-blur-md border-b border-[#EAEFF5] px-8 flex items-center justify-between sticky top-0 z-10' data-purpose='topbar')
      h1(class='text-xl font-bold tracking-tight text-[#0F172A]') Reports Management
      span(class='text-xs font-semibold text-[#0055D6]') Administrator

    main(class='flex-1 p-8 space-y-7 max-w-[1500px] w-full mx-auto')
      section(class='grid grid-cols-1 sm:grid-cols-3 gap-5' data-purpose='metrics-row')
        div(class='bg-white rounded-xl p-5 border border-[#EDF2F7] shadow-sm flex flex-col items-center justify-center text-center')
          span(class='text-[11px] font-bold text-[#8A99AD] tracking-wider uppercase') OPEN REPORTS
          span(class='text-3xl font-extrabold text-[#0F172A] my-1')= summary.open
        div(class='bg-white rounded-xl p-5 border border-[#EDF2F7] shadow-sm flex flex-col items-center justify-center text-center')
          span(class='text-[11px] font-bold text-[#8A99AD] tracking-wider uppercase') IN REVIEW
          span(class='text-3xl font-extrabold text-[#0F172A] my-1')= summary.inReview
        div(class='bg-white rounded-xl p-5 border border-[#EDF2F7] shadow-sm flex flex-col items-center justify-center text-center')
          span(class='text-[11px] font-bold text-[#8A99AD] tracking-wider uppercase') RESOLVED
          span(class='text-3xl font-bold text-[#0F172A] my-1')= summary.resolved

      section(class='bg-white rounded-2xl border border-[#EDF2F7] shadow-sm overflow-hidden p-6' data-purpose='reports-table-section')
        .mb-6
          h2(class='text-lg font-bold text-[#0F172A]') All Reports
          p(class='text-xs text-[#64748B] mt-0.5') Review user, message, and bug reports and update their status.

        .overflow-x-auto
          table.w-full.text-left.border-collapse
            thead
              tr(class='bg-[#F8FAFC] border-b border-[#F1F5F9]')
                th(class='py-3 px-4 text-[11px] font-bold text-[#64748B] tracking-wider uppercase') SUBJECT
                th(class='py-3 px-4 text-[11px] font-bold text-[#64748B] tracking-wider uppercase') TYPE
                th(class='py-3 px-4 text-[11px] font-bold text-[#64748B] tracking-wider uppercase') SUBMITTER
                th(class='py-3 px-4 text-[11px] font-bold text-[#64748B] tracking-wider uppercase') STATUS
                th(class='py-3 px-4 text-[11px] font-bold text-[#64748B] tracking-wider uppercase text-right') UPDATE
            tbody(class='divide-y divide-[#F1F5F9] text-xs')
              each report in reports
                tr(class='hover:bg-[#FBFDFF] transition-colors')
                  td(class='py-4 px-4')
                    .font-bold(class='text-[#0F172A]')= report.subject
                    div(class='text-[11px] text-[#94A3B8]')= report.description
                  td(class='py-4 px-4 text-[#475569] capitalize')= report.type
                  td(class='py-4 px-4 text-[#475569]')= report.submitterName
                  td(class='py-4 px-4')
                    span(class='inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-[#FEF3C7] text-[#D97706] capitalize')= report.status.replace('_', ' ')
                  td(class='py-4 px-4 text-right')
                    form.inline-flex.items-center.gap-2(method='POST' action=`/admin/reports/${report.id}/status`)
                      input(type='hidden' name='_csrf' value=csrfToken)
                      select(class='py-1 px-2 rounded border border-slate-200 text-xs' name='status')
                        option(value='open' selected=(report.status === 'open')) Open
                        option(value='in_review' selected=(report.status === 'in_review')) In Review
                        option(value='resolved' selected=(report.status === 'resolved')) Resolved
                      button(class='text-[#0055D6] hover:underline font-bold text-xs' type='submit') Save
