extends ../layouts/base

block content
  main.flex-1.flex.items-center.justify-center.px-4.py-16
    .max-w-md.w-full.bg-white.rounded-2xl.p-8.border.border-slate-100.shadow-sm.text-center.space-y-3
      p.text-4xl.font-extrabold.text-brand-blue= statusCode || 500
      h1.text-xl.font-bold.text-slate-900= title || 'Something went wrong'
      p.text-sm.text-slate-600= message || 'An unexpected error occurred. Please try again.'
      .pt-3
        a(
          class='inline-flex items-center px-5 py-2.5 rounded-full bg-[#0058b8] hover:bg-[#004ba0] text-white text-sm font-semibold transition-colors'
          href=(currentUser ? '/suggestions' : '/')
        )= currentUser ? 'Back to dashboard' : 'Back to home'
