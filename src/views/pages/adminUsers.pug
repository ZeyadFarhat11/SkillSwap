extends ../layouts/base

block content
  div(class='flex-1 flex flex-col min-w-0')
    include ../partials/adminTopbar

    main(class='p-8 lg:p-10 max-w-7xl w-full')
      div(class='flex items-center justify-between mb-8')
        h1(class='text-2xl font-bold text-slate-800') User Management
        div(class='text-sm font-medium text-slate-500')
          a(class='text-blue-600 font-medium hover:text-blue-800' href='/admin/users') User Management
          span(class='mx-1 text-slate-300') /
          span Admin

      section(class='grid grid-cols-1 md:grid-cols-3 gap-6 mb-8' data-purpose='metrics-summary')
        div(class='bg-white rounded-2xl p-6 text-center card-shadow border border-slate-100 flex flex-col justify-center items-center h-32')
          p(class='text-sm font-medium text-slate-500 mb-1') Users
          h2(class='text-2xl font-bold text-slate-900')= summary.totalUsers
        div(class='bg-white rounded-2xl p-6 text-center card-shadow border border-slate-100 flex flex-col justify-center items-center h-32')
          p(class='text-sm font-medium text-slate-500 mb-1') Points
          h2(class='text-2xl font-bold text-slate-900')= summary.totalPoints
        div(class='bg-white rounded-2xl p-6 text-center card-shadow border border-slate-100 flex flex-col justify-center items-center h-32')
          p(class='text-sm font-medium text-slate-500 mb-1') Active Users
          h2(class='text-2xl font-bold text-slate-900')= summary.activeUsers
          if summary.suspendedUsers > 0
            span(class='text-[11px] font-medium text-rose-500 mt-1')= `${summary.suspendedUsers} suspended`

      section(class='bg-white rounded-2xl p-6 mb-8 card-shadow border border-slate-100' data-purpose='overview-graph')
        div(class='flex items-center justify-between mb-6')
          h3(class='text-base font-bold text-slate-800') Overview
          div(class='flex items-center space-x-6 text-xs font-medium text-slate-500')
            div(class='flex items-center space-x-2')
              span(class='w-2.5 h-2.5 rounded-full bg-[#4361ee]')
              span Learner
            div(class='flex items-center space-x-2')
              span(class='w-2.5 h-2.5 rounded-full bg-[#58c7cc]')
              span Teacher

        div(class='w-full relative pt-2')
          svg(class='w-full h-auto overflow-visible' preserveAspectRatio='none' viewBox='0 0 760 220')
            line(stroke='#f1f5f9' stroke-width='1.5' x1='28' x2='760' y1='20' y2='20')
            text(fill='#94a3b8' font-size='11' text-anchor='end' x='14' y='24') 80
            line(stroke='#f1f5f9' stroke-width='1.5' x1='28' x2='760' y1='50' y2='50')
            text(fill='#94a3b8' font-size='11' text-anchor='end' x='14' y='54') 70
            line(stroke='#f1f5f9' stroke-width='1.5' x1='28' x2='760' y1='80' y2='80')
            text(fill='#94a3b8' font-size='11' text-anchor='end' x='14' y='84') 60
            line(stroke='#f1f5f9' stroke-width='1.5' x1='28' x2='760' y1='110' y2='110')
            text(fill='#94a3b8' font-size='11' text-anchor='end' x='14' y='114') 50
            line(stroke='#f1f5f9' stroke-width='1.5' x1='28' x2='760' y1='140' y2='140')
            text(fill='#94a3b8' font-size='11' text-anchor='end' x='14' y='144') 40
            line(stroke='#f1f5f9' stroke-width='1.5' x1='28' x2='760' y1='170' y2='170')
            text(fill='#94a3b8' font-size='11' text-anchor='end' x='14' y='174') 30
            line(stroke='#cbd5e1' stroke-width='1.5' x1='28' x2='760' y1='200' y2='200')
            text(fill='#94a3b8' font-size='11' text-anchor='end' x='14' y='204') 20
            path(
              d='M 30,128 C 70,125 100,85 150,75 C 200,65 240,30 270,30 C 310,30 330,98 380,105 C 420,110 460,135 520,135 C 580,135 620,138 670,165 C 710,185 730,188 760,188'
              fill='none'
              stroke='#4361ee'
              stroke-linecap='round'
              stroke-width='3.5'
            )
            path(
              d='M 30,195 C 60,190 90,140 140,122 C 180,110 210,100 270,95 C 330,90 350,155 400,155 C 450,155 520,150 560,118 C 600,86 640,135 680,185 C 710,200 730,196 760,194'
              fill='none'
              stroke='#58c7cc'
              stroke-linecap='round'
              stroke-width='3.5'
            )

          div(class='flex justify-between pl-7 pr-2 pt-3 text-[11px] font-medium text-slate-500')
            span Jan
            span Feb
            span Mar
            span Apr
            span May
            span Jun
            span Jul

      section(class='bg-white rounded-2xl card-shadow border border-slate-100 overflow-hidden' data-purpose='users-table')
        div(class='px-7 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100')
          h3(class='text-base font-bold text-slate-800') All Users

          form(class='flex flex-wrap items-center gap-2.5' method='GET' action='/admin/users' data-purpose='users-search-form')
            div(class='relative w-64')
              span(class='absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400')
                svg(class='w-3.5 h-3.5' fill='none' stroke='currentColor' viewBox='0 0 24 24')
                  path(d='M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z' stroke-linecap='round' stroke-linejoin='round' stroke-width='2')
              input(
                class='w-full pl-9 pr-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-700 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:bg-white'
                type='text'
                name='q'
                placeholder='Search users by name or email...'
                value=(filters && filters.q ? filters.q : '')
                data-table-search-target='adminUsersTable'
                aria-label='Search users'
              )
            select(
              class='py-1.5 pl-3 pr-8 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-600 focus:outline-none focus:ring-1 focus:ring-blue-500'
              name='status'
              aria-label='Filter users by status'
            )
              option(value='' selected=(!filters || !filters.status)) All Status
              option(value='active' selected=(filters && filters.status === 'active')) Active
              option(value='suspended' selected=(filters && filters.status === 'suspended')) Suspended
            button(class='px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition cursor-pointer' type='submit') Search
            if filters && (filters.q || filters.status)
              a(class='text-xs font-semibold text-blue-600 hover:underline px-1' href='/admin/users') Clear

        .overflow-x-auto
          table#adminUsersTable(class='w-full text-left text-xs')
            thead
              tr(class='bg-slate-50 text-slate-600 font-semibold border-b border-slate-100')
                th(class='py-3.5 px-6' scope='col') ID
                th(class='py-3.5 px-6' scope='col') User
                th(class='py-3.5 px-6' scope='col') Email
                th(class='py-3.5 px-6' scope='col') Status
                th(class='py-3.5 px-6 text-center' scope='col') Points
                th(class='py-3.5 px-6' scope='col') Points Adjustment
                th(class='py-3.5 px-6 text-right' scope='col') Action
            tbody(class='divide-y divide-slate-100 text-slate-600')
              if !users || !users.length
                tr
                  td(class='py-6 px-6 text-center text-slate-400' colspan='7') No users found.
              else
                each userItem in users
                  tr(
                    class='hover:bg-slate-50/50 transition-colors'
                    data-search-row='true'
                    data-search-text=`${userItem.id} ${userItem.name} ${userItem.email} ${userItem.role} ${userItem.status}`
                  )
                    td(class='py-3.5 px-6 font-normal text-slate-500')= userItem.id
                    td(class='py-3.5 px-6 font-medium text-slate-800')
                      div(class='flex items-center space-x-3')
                        if userItem.avatarPath
                          img(alt=userItem.name class='w-7 h-7 rounded-full object-cover' src=`/${userItem.avatarPath}`)
                        else
                          div(class='w-7 h-7 rounded-full bg-slate-100 text-slate-600 font-bold text-[10px] flex items-center justify-center shrink-0')
                            = userItem.name ? userItem.name.slice(0, 2).toUpperCase() : 'U'
                        span= userItem.name
                        if userItem.role === 'admin'
                          span(class='inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-50 text-[#0d59cf]') Admin
                    td(class='py-3.5 px-6 text-slate-500')= userItem.email
                    td(class='py-3.5 px-6 capitalize')
                      if userItem.status === 'suspended'
                        span(class='inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-rose-50 text-rose-600')= userItem.status
                      else
                        span(class='inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-[#E6F8F0] text-[#059669]')= userItem.status
                    td(class='py-3.5 px-6 text-center font-semibold text-slate-800')= userItem.pointsBalance
                    td(class='py-3.5 px-6')
                      form(class='inline-flex items-center gap-1.5' method='POST' action=`/admin/users/${userItem.id}/points-adjustment`)
                        input(type='hidden' name='_csrf' value=csrfToken)
                        input(
                          class='w-20 px-2 py-1 text-xs bg-slate-50 border border-slate-200 rounded focus:outline-none focus:border-blue-500'
                          type='number'
                          name='amount'
                          step='1'
                          placeholder='+/- pts'
                          aria-label=`Adjust points for ${userItem.name}`
                          required
                        )
                        button(class='px-2.5 py-1 rounded bg-[#0d59cf] hover:bg-blue-700 text-white text-[11px] font-semibold cursor-pointer' type='submit') Adjust
                    td(class='py-3.5 px-6 text-right whitespace-nowrap')
                      if userItem.role === 'admin'
                        span(class='text-slate-400') Protected
                      else if userItem.status === 'active'
                        form.inline(method='POST' action=`/admin/users/${userItem.id}/suspend`)
                          input(type='hidden' name='_csrf' value=csrfToken)
                          button(class='text-rose-600 hover:underline font-semibold cursor-pointer' type='submit') Suspend
                      else
                        form.inline(method='POST' action=`/admin/users/${userItem.id}/reactivate`)
                          input(type='hidden' name='_csrf' value=csrfToken)
                          button(class='text-emerald-600 hover:underline font-semibold cursor-pointer' type='submit') Reactivate
                tr(class='hidden' data-empty-search-row='true')
                  td(class='py-6 px-6 text-center text-slate-400' colspan='7') No matching users found.

block scripts
  script(src='/js/adminSearch.js')
