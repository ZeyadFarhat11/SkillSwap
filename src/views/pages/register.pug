extends ../layouts/base

block content
  main(class='w-full max-w-[1380px] mx-auto flex flex-col items-center' data-purpose='signup-card')
    header.flex.flex-col.items-center.mb-10.text-center(data-purpose='brand-header')
      .relative.w-16.h-16.flex.items-center.justify-center.mb-1(aria-hidden='true')
        svg.w-full.h-full.drop-shadow-sm.overflow-visible(aria-label='SkillSwap Lightbulb Logo' fill='none' viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg')
          g(stroke='#F59E0B' stroke-linecap='round' stroke-width='4.5')
            line(x1='24' y1='24' x2='37' y2='36' stroke='#FBBF24' stroke-width='4')
            line(x1='16' y1='54' x2='30' y2='54')
            line(x1='24' y1='84' x2='36' y2='75' stroke='#FBBF24' stroke-width='4')
            line(x1='96' y1='24' x2='83' y2='36' stroke='#FBBF24' stroke-width='4')
            line(x1='104' y1='54' x2='90' y2='54')
            line(x1='96' y1='84' x2='84' y2='75' stroke='#FBBF24' stroke-width='4')
            circle(cx='60' cy='6' r='2.5' fill='#F59E0B')
          path(d='M60 16C43.5 16 33 28.5 33 46C33 57.5 40 68 47.5 76H72.5C80 68 87 57.5 87 46C87 28.5 76.5 16 60 16Z' fill='#FFFFFF' stroke='#0A3B7B' stroke-linejoin='round' stroke-width='5')
          path(d='M49 84H71' stroke='#0A3B7B' stroke-linecap='round' stroke-width='5')
          path(d='M51 92H69' stroke='#0A3B7B' stroke-linecap='round' stroke-width='5')
          path(d='M55 99H65' stroke='#0A3B7B' stroke-linecap='round' stroke-width='4')
          circle(cx='49' cy='40' fill='#0A3B7B' r='5')
          path(d='M41 55C41 49.5 44.5 47 49 47C53.5 47 57 49.5 57 55' fill='#0A3B7B')
          circle(cx='71' cy='40' fill='#00A865' r='5')
          path(d='M63 55C63 49.5 66.5 47 71 47C75.5 47 79 49.5 79 55' fill='#00A865')
          path(d='M52 30C55 28 64 28 68 31' fill='none' stroke='#0A3B7B' stroke-linecap='round' stroke-width='3')
          polygon(fill='#0A3B7B' points='69,27 75,32 68,36')
          path(d='M68 62C65 65 56 65 52 62' fill='none' stroke='#00A865' stroke-linecap='round' stroke-width='3')
          polygon(fill='#00A865' points='51,65 45,61 52,57')

      h1(class='text-[26px] font-extrabold tracking-tight text-[#0052cc] flex items-center justify-center')
        | Skill
        span(class='text-[#059669]') Swap

      p.text-sm.font-medium.text-slate-500.mt-2.tracking-normal Learn something. Teach something.

    form#signupForm.w-full.space-y-4(method='POST' action='/register' data-purpose='registration-form' novalidate)
      input(type='hidden' name='_csrf' value=csrfToken)

      div
        label.sr-only(for='firstName') First Name
        input#firstName(
          autocomplete='given-name'
          class=`form-input-field ${errors && errors.firstName ? 'input-error' : ''}`
          name='firstName'
          placeholder='First Name'
          type='text'
          value=(formData && formData.firstName) || ''
        )
        p#firstNameError.error-message(style=errors && errors.firstName ? 'display:block' : '')= (errors && errors.firstName) || ''

      div
        label.sr-only(for='lastName') Last Name
        input#lastName(
          autocomplete='family-name'
          class=`form-input-field ${errors && errors.lastName ? 'input-error' : ''}`
          name='lastName'
          placeholder='Last Name'
          type='text'
          value=(formData && formData.lastName) || ''
        )
        p#lastNameError.error-message(style=errors && errors.lastName ? 'display:block' : '')= (errors && errors.lastName) || ''

      div
        label.sr-only(for='email') Email
        input#email(
          autocomplete='email'
          class=`form-input-field ${errors && errors.email ? 'input-error' : ''}`
          name='email'
          placeholder='Email'
          type='email'
          value=(formData && formData.email) || ''
        )
        p#emailError.error-message(style=errors && errors.email ? 'display:block' : '')= (errors && errors.email) || ''

      div
        label.sr-only(for='password') Password
        input#password(
          autocomplete='new-password'
          class=`form-input-field ${errors && errors.password ? 'input-error' : ''}`
          name='password'
          placeholder='Password'
          type='password'
        )
        p#passwordError.error-message(style=errors && errors.password ? 'display:block' : '')= (errors && errors.password) || ''

      div
        label.sr-only(for='confirmPassword') Confirm Password
        input#confirmPassword(
          autocomplete='new-password'
          class=`form-input-field ${errors && errors.confirmPassword ? 'input-error' : ''}`
          name='confirmPassword'
          placeholder='Confirm Password'
          type='password'
        )
        p#confirmPasswordError.error-message(style=errors && errors.confirmPassword ? 'display:block' : '')= (errors && errors.confirmPassword) || ''

      .pt-2(data-purpose='action-container')
        button#submit-button(
          class='w-full bg-[#0052cc] hover:bg-[#0047b3] active:bg-[#003d99] text-white font-medium py-3.5 px-6 rounded-full shadow-sm transition-colors duration-150 text-base flex justify-center items-center tracking-wide'
          type='submit'
        ) Sign Up

    .mt-6.text-center(data-purpose='login-link-container')
      a(class='text-sm font-semibold text-[#0052cc] hover:underline focus:outline-none focus:ring-2 focus:ring-blue-400 rounded-sm' href='/login') Already have an account? Log In

block scripts
  script(src='/js/auth.js')
