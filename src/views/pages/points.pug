extends ../layouts/base

block content
  main(class='flex-1 px-10 py-8 max-w-7xl overflow-y-auto')
    header.mb-8(data-purpose='page-header')
      h1(class='text-[28px] font-bold text-slate-900 leading-tight') Points Wallet
      p.text-slate-500.text-sm.mt-1 Track your rewards, earn points, and see your activity.

    section.space-y-6.mb-10(data-purpose='balance-and-stats')
      div(class='bg-[#0456c8] rounded-[22px] px-10 py-9 text-white shadow-sm flex items-center justify-between relative overflow-hidden')
        div
          p(class='text-[12px] font-bold tracking-wider text-blue-100 uppercase opacity-90 mb-2') YOUR BALANCE
          .flex.items-baseline.gap-3
            span.text-6xl.font-extrabold.tracking-tight= wallet.balance
          p(class='text-[12px] font-bold tracking-wider text-blue-100 uppercase mt-2') POINTS
        .relative.mr-8
          div(class='w-48 h-28 bg-[#3371cb] bg-opacity-70 backdrop-blur-sm rounded-xl p-4 flex flex-col justify-center items-center shadow-inner border border-blue-400/20')
            span(class='text-[10px] font-bold tracking-wider text-white uppercase text-center') SKILLSWAP WALLET

      div(class='grid grid-cols-1 md:grid-cols-3 gap-6')
        div(class='bg-white rounded-2xl p-6 text-center shadow-[0_2px_8px_rgba(0,0,0,0.02)]')
          p.text-xs.font-medium.text-slate-400.mb-2 Total Earned
          p.text-2xl.font-bold.text-slate-900.tracking-tight= `${wallet.totalEarned} points`
        div(class='bg-white rounded-2xl p-6 text-center shadow-[0_2px_8px_rgba(0,0,0,0.02)]')
          p.text-xs.font-medium.text-slate-400.mb-2 Total Spent
          p.text-2xl.font-bold.text-slate-900.tracking-tight= `${wallet.totalSpent} points`
        div(class='bg-white rounded-2xl p-6 text-center shadow-[0_2px_8px_rgba(0,0,0,0.02)]')
          p.text-xs.font-medium.text-slate-400.mb-2 Points This Month
          p.text-2xl.font-bold.text-slate-900.tracking-tight= `${wallet.thisMonth} points`

    section(data-purpose='activity-and-actions')
      h2.text-lg.font-bold.text-slate-900.mb-4 Points Activity
      div(class='grid grid-cols-1 lg:grid-cols-12 gap-6 items-start')
        div(class='lg:col-span-7 bg-white rounded-2xl p-6 shadow-[0_2px_8px_rgba(0,0,0,0.02)]' data-purpose='recent-transactions')
          h3.text-sm.font-bold.text-slate-900.mb-5 Recent Transactions
          table.w-full.text-left
            thead
              tr(class='text-[11px] font-bold text-slate-400 uppercase tracking-wider')
                th.pb-3.pl-1.font-semibold.text-slate-400 ACTIVITY
                th.pb-3.text-center.font-semibold.text-slate-400 DATE
                th.pb-3.pr-1.text-right.font-semibold.text-slate-400 POINTS
            tbody.divide-y.divide-slate-50
              if !transactions || !transactions.length
                tr
                  td(class='py-6 text-center text-xs text-slate-400' colspan='3') No points transactions yet.
              else
                each tx in transactions
                  tr
                    td(class='py-3.5 pl-1')
                      .flex.items-center.gap-3
                        if tx.isCredit
                          span.w-7.h-7.rounded-full.bg-emerald-50.text-emerald-600.flex.items-center.justify-center.font-bold.text-sm.shrink-0 +
                        else
                          span.w-7.h-7.rounded-full.bg-rose-50.text-rose-500.flex.items-center.justify-center.font-bold.text-sm.shrink-0 −
                        div
                          p.text-xs.font-semibold.text-slate-900= tx.label
                          p(class='text-[11px] text-slate-400 mt-0.5 capitalize')= tx.type
                    td(class='py-3.5 text-center text-xs text-slate-500 whitespace-nowrap')= tx.dateLabel
                    td(class='py-3.5 pr-1 text-right whitespace-nowrap')
                      if tx.isCredit
                        span.text-xs.font-bold.text-emerald-600= `+${tx.amount} pts`
                      else
                        span.text-xs.font-bold.text-rose-500= `-${tx.amount} pts`

        div(class='lg:col-span-5 bg-white rounded-2xl p-6 shadow-[0_2px_8px_rgba(0,0,0,0.02)]' data-purpose='ways-to-earn')
          h3.text-sm.font-bold.text-slate-900.mb-4 Ways to Earn Points
          .space-y-3
            div(class='bg-[#f8fafc] rounded-xl p-3.5 flex items-center justify-between')
              div
                p.text-xs.font-semibold.text-slate-900 Complete a teaching session
                p(class='text-[11px] text-slate-400 mt-0.5') Earn points for one-way sessions you teach
              span.text-xs.font-bold.text-emerald-600.px-2= `+${pointsPerSession !== undefined ? pointsPerSession : 10}`
            div(class='bg-[#f8fafc] rounded-xl p-3.5 flex items-center justify-between')
              div
                p.text-xs.font-semibold.text-slate-900 Starter welcome bonus
                p(class='text-[11px] text-slate-400 mt-0.5') Granted automatically on registration
              span.text-xs.font-bold.text-emerald-600.px-2= `+${starterPoints}`
