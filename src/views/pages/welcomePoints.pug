extends ../layouts/base

block content
  main(class='relative w-full max-w-[580px] flex justify-center items-center' data-purpose='modal-wrapper')
    div(aria-hidden='true' class='absolute -left-8 top-[24%] -translate-y-1/2 pointer-events-none z-10' data-purpose='decorative-element')
      svg(class='w-12 h-12 text-[#ffbe00] drop-shadow-sm' fill='currentColor' viewBox='0 0 24 24')
        path(d='M12 0L14.4 8.6L23 11L14.4 13.4L12 22L9.6 13.4L1 11L9.6 8.6L12 0Z')
    div(aria-hidden='true' class='absolute -left-3 top-[44%] pointer-events-none z-10' data-purpose='decorative-element')
      span(class='block w-2.5 h-2.5 rounded-full bg-[#004bb5]')
    div(aria-hidden='true' class='absolute -right-6 top-[28%] -translate-y-1/2 pointer-events-none z-10' data-purpose='decorative-element')
      svg(class='w-10 h-10 text-[#ffbe00] drop-shadow-sm' fill='currentColor' viewBox='0 0 24 24')
        path(d='M12 0L14.2 8.8L23 11L14.2 13.2L12 22L9.8 13.2L1 11L9.8 8.8L12 0Z')
    div(aria-hidden='true' class='absolute -right-6 top-[48%] pointer-events-none z-10' data-purpose='decorative-element')
      svg(class='w-8 h-8 text-[#0047b3]' fill='currentColor' viewBox='0 0 24 24')
        path(d='M12 0L14.5 8.5L23 11L14.5 13.5L12 22L9.5 13.5L1 11L9.5 8.5L12 0Z')

    section(class='relative w-full bg-white rounded-[40px] shadow-[0_20px_50px_rgba(180,195,225,0.45)] px-8 pt-10 pb-12 flex flex-col items-center overflow-hidden' data-purpose='reward-card')
      div(aria-hidden='true' class='absolute top-12 left-[18%] w-1.5 h-5 bg-[#52bca7] rounded-full transform -rotate-12 pointer-events-none')
      div(aria-hidden='true' class='absolute top-18 left-[13%] w-2 h-5 bg-[#fab500] rounded-full transform -rotate-45 pointer-events-none')
      div(aria-hidden='true' class='absolute top-[35%] left-[7%] w-7 h-2 bg-[#0052cc] rounded-full transform -rotate-12 pointer-events-none')
      div(aria-hidden='true' class='absolute top-19 right-[19%] w-1.5 h-5 bg-[#52bca7] rounded-full transform rotate-45 pointer-events-none')
      div(aria-hidden='true' class='absolute top-[35%] right-[11%] w-6 h-2 bg-[#fab500] rounded-full transform rotate-12 pointer-events-none')

      .relative.w-48.h-48.mb-8.flex.items-center.justify-center(data-purpose='coin-badge')
        div(class='w-48 h-48 rounded-full bg-[#fef5db] flex items-center justify-center p-3')
          div(class='w-full h-full rounded-full bg-gradient-to-b from-[#e39c1e] to-[#f4b834] p-3 flex items-center justify-center shadow-inner')
            div(class='w-full h-full rounded-full bg-[#fad355] border-2 border-[#ea9d1b] flex items-center justify-center relative shadow-[inset_0_4px_8px_rgba(217,119,6,0.25)]')
              svg(class='w-24 h-24 text-white drop-shadow-[0_2px_4px_rgba(180,83,9,0.15)]' fill='currentColor' viewBox='0 0 24 24')
                path(d='M12 1.5L15.3 8.2L22.7 9.3L17.3 14.6L18.6 22L12 18.5L5.4 22L6.7 14.6L1.3 9.3L8.7 8.2L12 1.5Z')

      .text-center.w-full.max-w-sm.flex.flex-col.items-center
        p(class='text-[#899cb6] text-base font-semibold tracking-wide mb-2' data-purpose='reward-congratulations') Congratulations
        h1(class='text-2xl sm:text-3xl font-extrabold text-[#111827] tracking-tight mb-4' data-purpose='reward-heading') You Earned Points!
        .flex.flex-col.items-center.my-1(data-purpose='points-counter')
          span(class='text-5xl sm:text-6xl font-black text-[#0052cc] tracking-tight leading-none mb-2')= `+${starterPoints}`
          span(class='text-sm font-bold uppercase tracking-wider text-[#475569]') POINTS
        p(class='text-sm text-[#738499] font-medium mt-6 mb-8' data-purpose='encouragement-message') Keep swapping skills and growing together.
        a(
          class='w-full max-w-[280px] h-[52px] bg-[#0052cc] hover:bg-[#0047b3] active:scale-[0.98] transition-all duration-150 rounded-2xl text-white font-semibold text-base flex items-center justify-center shadow-[0_4px_14px_rgba(0,82,204,0.3)] focus:outline-none focus:ring-4 focus:ring-blue-300'
          data-purpose='continue-button'
          href='/skills'
        ) Continue
