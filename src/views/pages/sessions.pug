extends ../layouts/base

block content
  main(class='flex-1 px-10 py-8 overflow-y-auto max-w-[1200px]')
    header.flex.items-start.justify-between.mb-8
      div
        h1.text-2xl.font-bold.text-slate-900.tracking-tight Session
        p.text-sm.text-slate-500.mt-1.font-medium Manage your learning and teaching sessions in one place.

    section(class='grid grid-cols-1 md:grid-cols-3 gap-6 mb-10')
      div(class='bg-white rounded-2xl p-6 shadow-[0_2px_10px_rgba(0,0,0,0.03)] border border-slate-100 flex flex-col justify-between h-[120px]')
        span.text-sm.font-bold.text-amber-500.tracking-wide Upcoming Sessions
        span.text-3xl.font-bold.text-slate-900.leading-none= stats.upcoming
      div(class='bg-white rounded-2xl p-6 shadow-[0_2px_10px_rgba(0,0,0,0.03)] border border-slate-100 flex flex-col justify-between h-[120px]')
        span.text-sm.font-bold.text-emerald-500.tracking-wide Completed Sessions
        span.text-3xl.font-bold.text-slate-900.leading-none= stats.completed
      div(class='bg-white rounded-2xl p-6 shadow-[0_2px_10px_rgba(0,0,0,0.03)] border border-slate-100 flex flex-col justify-between h-[120px]')
        span.text-sm.font-bold.text-orange-500.tracking-wide Pending Requests
        span.text-3xl.font-bold.text-slate-900.leading-none= stats.pending

    section.mb-10
      h2.text-lg.font-bold.text-slate-900.mb-4.tracking-tight Your Schedule
      .space-y-4
        each item in sessionsList
          article(class='bg-white rounded-2xl p-5 shadow-[0_2px_10px_rgba(0,0,0,0.03)] border border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4')
            .flex.items-center.gap-5
              div(class='w-16 bg-[#E9F2FE] rounded-2xl flex flex-col items-center justify-center p-2.5 text-center shrink-0')
                span(class='text-[10px] font-bold text-[#0B63E5] tracking-wider uppercase')= item.month
                span(class='text-2xl font-black text-[#0B63E5] leading-none my-0.5')= item.day
                span(class='text-[9px] font-bold text-[#0B63E5]/70 tracking-wider uppercase')= item.weekday
              div(class='w-11 h-11 rounded-full bg-[#e9f0fc] text-[#0B63E5] flex items-center justify-center font-bold text-sm shrink-0')= item.partnerName.charAt(0).toUpperCase()
              div
                h3.text-sm.font-bold.text-slate-900= item.skillTitle
                p(class='text-xs text-slate-500 mt-0.5')= `with ${item.partnerName} • ${item.roleLabel}`
                div(class='mt-2.5')
                  span(class='inline-block px-3.5 py-1 bg-[#EEF4FF] text-[#0B63E5] text-[11px] font-semibold rounded-md')= item.category

            .flex.items-center.gap-4
              span.text-xs.font-semibold.text-slate-700= item.timeRange
              span(class='px-3 py-1 bg-[#E8FAF0] text-[#12B76A] text-xs font-semibold rounded-full capitalize')= item.status
              if item.status === 'completed'
                a(class='px-4 py-2 bg-[#0B63E5] hover:bg-[#0052CC] text-white text-xs font-semibold rounded-xl shadow-sm transition-colors' href=`/sessions/${item.id}/review`) Leave Review
              else
                a(class='px-4 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-xl transition-colors' href=`/users/${item.partnerId}`) View Profile

    section(class='bg-[#edf3fe] w-full max-w-2xl rounded-2xl p-7 pt-6 shadow-sm' data-purpose='calendar-modal-card')
      h2.text-base.font-bold.text-slate-800.mb-4 Schedule an Accepted Swap Slot
      p.text-xs.text-slate-600.mb-4 Shared availability preview (slot booking will be wired in Phase 5).
      div(class='space-y-2.5')
        each slot in schedulerSlots
          div(class=`w-full rounded-xl py-3 text-center font-semibold text-sm shadow-sm ${slot.selected ? 'bg-[#0b57cf] text-white' : 'bg-white text-slate-900 border border-slate-200/80'}`)= slot.label
