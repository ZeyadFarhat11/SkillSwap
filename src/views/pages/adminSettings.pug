extends ../layouts/base

block content
  div(class='flex-1 flex flex-col min-w-0')
    include ../partials/adminTopbar

    main(class='flex-1 px-8 lg:px-10 py-6 max-w-[1320px] w-full' data-purpose='settings-content')
      div(class='flex items-start justify-between mb-8')
        div
          h2(class='text-2xl font-bold text-slate-900 tracking-tight') Settings
          p(class='text-sm text-slate-500 mt-1') Manage your platform information, preferences, and system configuration.

      div(class='bg-white rounded-xl border border-slate-100 shadow-sm p-1.5 mb-8')
        nav(class='flex flex-wrap items-center space-x-1' data-purpose='settings-tabs')
          a(class='px-6 py-2 rounded-lg text-sm font-medium text-[#0052B4] bg-[#EAF2FF] transition' href='#general-info') General
          a(class='px-6 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-slate-900 transition' href='#platform-preferences') Preferences
          a(class='px-6 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-slate-900 transition' href='#admin-account') Account

      div(class='grid grid-cols-1 lg:grid-cols-12 gap-6 items-start')
        div(class='lg:col-span-7 space-y-6')
          section#general-info(class='bg-white rounded-2xl border border-slate-100 shadow-sm p-6' data-purpose='general-information-card')
            h3(class='text-base font-bold text-slate-900') General Information
            p(class='text-xs text-slate-500 mt-0.5 mb-5') Update the basic information and identity of your platform.

            form(class='space-y-4' method='POST' action='/admin/settings/general')
              input(type='hidden' name='_csrf' value=csrfToken)
              div
                label(class='block text-xs font-semibold text-slate-700 mb-1.5' for='platformName') Platform Name
                input#platformName(
                  class='w-full rounded-lg border-slate-200 text-sm text-slate-800 px-3.5 py-2.5 focus:border-[#0052B4] focus:ring-[#0052B4]'
                  type='text'
                  name='platformName'
                  value=settings.platformName
                  required
                )
              div
                label(class='block text-xs font-semibold text-slate-700 mb-1.5' for='platformEmail') Platform Email
                input#platformEmail(
                  class='w-full rounded-lg border-slate-200 text-sm text-slate-800 px-3.5 py-2.5 focus:border-[#0052B4] focus:ring-[#0052B4]'
                  type='email'
                  name='platformEmail'
                  value=settings.platformEmail
                  required
                )
              div
                label(class='block text-xs font-semibold text-slate-700 mb-1.5' for='platformDescription') Platform Description
                textarea#platformDescription(
                  class='w-full rounded-lg border-slate-200 text-sm text-slate-800 px-3.5 py-2.5 focus:border-[#0052B4] focus:ring-[#0052B4] resize-none'
                  name='platformDescription'
                  rows='3'
                  required
                )= settings.platformDescription
              div(class='pt-2 flex justify-end')
                button(
                  class='bg-[#0052B4] hover:bg-blue-700 text-white font-medium text-sm px-6 py-2.5 rounded-lg shadow-sm transition cursor-pointer'
                  type='submit'
                ) Save General Information

          section#platform-preferences(class='bg-white rounded-2xl border border-slate-100 shadow-sm p-6' data-purpose='platform-preferences-card')
            h3(class='text-base font-bold text-slate-900') Platform Preferences
            p(class='text-xs text-slate-500 mt-0.5 mb-6') Set default behavior for #{settings.platformName}.

            form(class='space-y-5' method='POST' action='/admin/settings/preferences')
              input(type='hidden' name='_csrf' value=csrfToken)

              div(class='flex items-center justify-between gap-4')
                div
                  h4(class='text-sm font-semibold text-slate-800') Allow new user registrations
                  p(class='text-xs text-slate-500') Let new members create an account.
                label(class='relative inline-flex items-center cursor-pointer shrink-0' for='allowRegistrations')
                  input#allowRegistrations.sr-only.peer(
                    type='checkbox'
                    name='allowRegistrations'
                    value='true'
                    checked=settings.allowRegistrations
                  )
                  div(class="w-11 h-6 bg-slate-200 rounded-full peer peer-checked:bg-[#0052B4] after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-5 shadow-inner")

              hr(class='border-slate-100')

              div(class='flex items-center justify-between gap-4')
                div
                  h4(class='text-sm font-semibold text-slate-800') Require email verification
                  p(class='text-xs text-slate-500') Verify user email addresses on signup.
                label(class='relative inline-flex items-center cursor-pointer shrink-0' for='requireEmailVerification')
                  input#requireEmailVerification.sr-only.peer(
                    type='checkbox'
                    name='requireEmailVerification'
                    value='true'
                    checked=settings.requireEmailVerification
                  )
                  div(class="w-11 h-6 bg-slate-200 rounded-full peer peer-checked:bg-[#0052B4] after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-5 shadow-inner")

              hr(class='border-slate-100')

              div(class='flex items-center justify-between gap-4')
                div
                  h4(class='text-sm font-semibold text-slate-800') Maintenance mode
                  p(class='text-xs text-slate-500') Temporarily pause access to the platform.
                label(class='relative inline-flex items-center cursor-pointer shrink-0' for='maintenanceMode')
                  input#maintenanceMode.sr-only.peer(
                    type='checkbox'
                    name='maintenanceMode'
                    value='true'
                    checked=settings.maintenanceMode
                  )
                  div(class="w-11 h-6 bg-slate-200 rounded-full peer peer-checked:bg-[#0052B4] after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-5 shadow-inner")

              div(class='pt-3 flex justify-end')
                button(
                  class='bg-[#0052B4] hover:bg-blue-700 text-white font-medium text-sm px-6 py-2.5 rounded-lg shadow-sm transition cursor-pointer'
                  type='submit'
                ) Save Preferences

        div(class='lg:col-span-5 space-y-6')
          section(class='bg-white rounded-2xl border border-slate-100 shadow-sm p-6' data-purpose='branding-card')
            h3(class='text-base font-bold text-slate-900') Branding
            p(class='text-xs text-slate-500 mt-0.5 mb-5') Platform identity overview.
            div(class='space-y-5')
              div
                label(class='block text-xs font-semibold text-slate-700 mb-1.5') Platform Identity
                div(class='border border-dashed border-slate-200 rounded-xl p-4 flex items-center gap-4 bg-slate-50/30')
                  div(class='w-12 h-12 rounded-xl bg-[#0052B4] flex items-center justify-center text-white font-extrabold text-sm shrink-0 shadow-sm')
                    = settings.platformName.slice(0, 2).toUpperCase()
                  div
                    h5(class='text-sm font-bold text-slate-800')= `${settings.platformName} Logo`
                    p(class='text-xs text-slate-400')= settings.platformEmail

              div
                label(class='block text-xs font-semibold text-slate-700 mb-1.5') Primary Color
                div(class='flex items-center justify-between border border-slate-200 rounded-lg px-3 py-2.5')
                  div(class='flex items-center gap-2.5')
                    span(class='w-4 h-4 rounded bg-[#0052B4] inline-block')
                    span(class='text-sm text-slate-800 font-medium') #0052B4

              div
                label(class='block text-xs font-semibold text-slate-700 mb-1.5') Language
                div(class='py-1')
                  span(class='text-sm text-slate-800') English (US)

          section#admin-account(class='bg-white rounded-2xl border border-slate-100 shadow-sm p-6' data-purpose='admin-account-card')
            h3(class='text-base font-bold text-slate-900') Admin Account
            p(class='text-xs text-slate-500 mt-0.5 mb-5') Your administrator profile and access details.
            div(class='flex items-center gap-3.5 mb-6')
              if currentUser && currentUser.avatarPath
                img(alt=currentUser.name class='w-12 h-12 rounded-full object-cover border border-slate-200' src=`/${currentUser.avatarPath}`)
              else
                div(class='w-12 h-12 rounded-full bg-blue-50 text-[#0052B4] font-bold text-sm flex items-center justify-center border border-blue-100')
                  = currentUser && currentUser.name ? currentUser.name.slice(0, 2).toUpperCase() : 'AD'
              div
                h4(class='text-sm font-bold text-slate-900 leading-tight')= currentUser ? currentUser.name : 'Administrator'
                p(class='text-xs text-slate-400 mt-0.5')= currentUser ? currentUser.email : 'admin@skillswap.local'
            hr(class='border-slate-100 mb-5')
            div(class='mb-4')
              label(class='block text-[11px] font-bold tracking-wider text-slate-400 uppercase mb-1') ROLE
              p(class='text-sm font-semibold text-[#0052B4]') Platform Administrator
            div
              label(class='block text-[11px] font-bold tracking-wider text-slate-400 uppercase mb-1') SUPPORT EMAIL
              p(class='text-xs text-slate-600')= settings.platformEmail
