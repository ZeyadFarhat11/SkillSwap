extends ../layouts/base

block content
  main(class='w-full max-w-5xl mx-auto flex-grow flex flex-col justify-between p-6 sm:p-8 md:p-10')
    .w-full
      header.relative.flex.items-center.justify-center.mb-8(data-purpose='header-section')
        a(
          aria-label='Go back'
          class='absolute left-0 w-11 h-11 rounded-full bg-white shadow-sm flex items-center justify-center text-slate-600 hover:text-slate-900 transition-colors border border-slate-100'
          href='/sessions'
        )
          svg(class='w-5 h-5 text-blue-600' fill='none' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2.2' viewBox='0 0 24 24')
            line(x1='19' x2='5' y1='12' y2='12')
            polyline(points='12 19 5 12 12 5')
        h1(class='text-xl md:text-2xl font-bold text-slate-800 tracking-tight') Leave a Review

      section(class='bg-white rounded-2xl p-5 md:p-6 shadow-sm border border-slate-100 flex items-center gap-4 mb-10' data-purpose='session-info')
        div(class='w-16 h-16 rounded-full bg-[#e9f0fc] text-[#0D3880] flex items-center justify-center text-xl font-bold shrink-0 ring-1 ring-slate-100')= sessionInfo.partnerName.charAt(0).toUpperCase()
        .flex.flex-col
          span(class='text-[11px] font-bold tracking-wider text-slate-400 uppercase') SESSION WITH
          h2(class='text-xl md:text-2xl font-bold text-[#0D3880] leading-snug')= sessionInfo.partnerName
          span.text-sm.font-medium.text-slate-400= sessionInfo.skillName

      form(method='POST' action=`/sessions/${sessionInfo.id}/rating` class='space-y-8')
        input(type='hidden' name='_csrf' value=csrfToken)

        section.flex.flex-col.items-center.justify-center.text-center(data-purpose='rating-stars')
          h3(class='text-base md:text-lg font-semibold text-slate-700 mb-4') How was your experience?
          .flex.items-center.gap-4.mb-2
            each star in [1, 2, 3, 4, 5]
              label(class='flex items-center gap-1.5 cursor-pointer px-3 py-2 rounded-xl bg-white border border-slate-200')
                input(type='radio' name='stars' value=star checked=(star === 5) class='text-amber-500 focus:ring-amber-400')
                span.text-sm.font-semibold.text-slate-700= `${star} ★`

        section(data-purpose='review-input')
          label(class='block text-sm font-semibold text-slate-700 mb-2.5' for='comment') Write your review
          textarea#comment(
            class='w-full rounded-2xl bg-white border border-slate-200 p-4 text-sm text-slate-700 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none transition resize-none leading-relaxed'
            name='comment'
            rows='5'
            placeholder='Share how the session went...'
          )

        .w-full.pt-2(data-purpose='submit-button-container')
          button(
            class='w-full py-4 rounded-full bg-[#0057B8] hover:bg-[#004ca3] text-white font-semibold text-base shadow-sm transition-all duration-150 text-center'
            type='submit'
          ) Submit Review
