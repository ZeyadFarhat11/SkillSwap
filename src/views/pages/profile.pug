extends ../layouts/base

block content
  main(class='flex-1 py-10 px-4 sm:px-6 bg-[#f8fafc]' data-purpose='profile-view')
    div(class='max-w-[1080px] mx-auto space-y-8')
      section(class='flex flex-col items-center justify-center text-center mt-2' data-purpose='user-header')
        .relative.mb-4
          if profile.avatarPath
            img#profile-avatar(
              alt=`${profile.name} Avatar`
              class='w-28 h-28 rounded-full object-cover shadow-[0_4px_16px_rgba(0,0,0,0.06)] border-2 border-white ring-1 ring-slate-100'
              src=`/${profile.avatarPath}`
            )
          else
            div(class='w-28 h-28 rounded-full bg-[#e9f0fc] text-[#0857c3] flex items-center justify-center text-3xl font-extrabold shadow-sm border-2 border-white ring-1 ring-slate-100')
              = profile.name ? profile.name.charAt(0).toUpperCase() : 'U'

        h1#profile-name(class='text-[26px] font-bold text-[#0d3880] tracking-tight mb-1')= profile.name
        if profile.bio
          p(class='text-slate-600 text-[14.5px] max-w-xl leading-relaxed mt-1')= profile.bio
        else
          p(class='text-slate-400 text-sm italic mt-1') No bio added yet.

        if isOwnProfile
          .flex.flex-wrap.items-center.justify-center.gap-3.mt-5
            a(class='px-5 py-2.5 rounded-full bg-[#0057C2] hover:bg-[#004bb0] text-white text-sm font-semibold shadow-sm transition-colors' href='/profile/edit') Edit Profile
            a(class='px-5 py-2.5 rounded-full bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-semibold transition-colors' href='/skills') Manage Skills
            a(class='px-5 py-2.5 rounded-full bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-semibold transition-colors' href='/availability') Manage Availability
        else
          .flex.flex-wrap.items-center.justify-center.gap-3.mt-5
            a(class='px-5 py-2.5 rounded-full bg-[#0057C2] hover:bg-[#004bb0] text-white text-sm font-semibold shadow-sm transition-colors' href=`/messages/${profile.id}`) Send Message
            a(class='px-5 py-2.5 rounded-full bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-semibold transition-colors' href=`/reports?userId=${profile.id}`) Report User

      if isOwnProfile
        section(class='grid grid-cols-1 sm:grid-cols-3 gap-5' data-purpose='stat-metrics')
          div(class='bg-[#e9f0fc] rounded-2xl py-4 flex flex-col items-center justify-center shadow-sm')
            span(class='text-2xl font-bold text-[#0857c3] leading-none mb-1')= profile.pointsBalance
            span(class='text-xs text-slate-500 font-medium') Points
          div(class='bg-[#e9f0fc] rounded-2xl py-4 flex flex-col items-center justify-center shadow-sm')
            span(class='text-2xl font-bold text-[#0857c3] leading-none mb-1')= profile.offerSkills.length
            span(class='text-xs text-slate-500 font-medium') Skills Offered
          div(class='bg-[#e9f0fc] rounded-2xl py-4 flex flex-col items-center justify-center shadow-sm')
            span(class='text-2xl font-bold text-[#0857c3] leading-none mb-1')= profile.wantSkills.length
            span(class='text-xs text-slate-500 font-medium') Skills Wanted

      section(class='bg-white rounded-2xl p-6 shadow-[0_1px_3px_rgba(0,0,0,0.04)] border border-slate-100' data-purpose='badges-earned')
        h2(class='text-xs font-bold text-slate-500 tracking-wider uppercase mb-4') BADGES EARNED
        div(class='grid grid-cols-2 sm:grid-cols-4 gap-4')
          each badge in (profile.badges || [])
            div(class='flex items-center gap-3' title=badge.description)
              if badge.earned
                div(class=`w-12 h-12 rounded-full flex items-center justify-center shadow-sm shrink-0 ${badge.colorClass}`)
                  svg(class='w-6 h-6' fill='currentColor' viewBox='0 0 24 24')
                    path(d='M12 2a5 5 0 0 0-5 5c0 1.636.786 3.09 2 4.015V22l5-3 5 3V11.015A5.003 5.003 0 0 0 12 2zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6zm2 13.518-2-1.2-2 1.2V12.7a5.05 5.05 0 0 0 2 .412c.72 0 1.399-.15 2-.412v4.818z')
              else
                div(class='w-12 h-12 rounded-full border-2 border-dashed border-slate-200 bg-slate-50/50 shrink-0')
              .min-w-0
                p(class=`text-xs font-bold leading-tight ${badge.earned ? 'text-slate-900' : 'text-slate-400'}`)= badge.title
                p(class='text-[11px] text-slate-400 truncate mt-0.5')= badge.description

      div(class='grid grid-cols-1 md:grid-cols-2 gap-6')
        section(class='bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-4' data-purpose='offer-skills-list')
          .flex.items-center.justify-between
            h2(class='text-base font-bold text-slate-900') Skills Offered
            if isOwnProfile
              a(class='text-xs font-semibold text-[#0857c3] hover:underline' href='/skills') Edit
          if profile.offerSkills.length
            div(class='flex flex-wrap gap-2.5')
              each item in profile.offerSkills
                span(class='px-4 py-1.5 rounded-full bg-[#D6F5E3] text-[#1E7E52] text-xs font-semibold tracking-wide inline-flex items-center gap-1.5')
                  span= item.skillName
                  span(class='opacity-75 font-medium')= `(${item.level})`
          else
            p.text-sm.text-slate-400 No offered skills listed yet.

        section(class='bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-4' data-purpose='want-skills-list')
          .flex.items-center.justify-between
            h2(class='text-base font-bold text-slate-900') Skills Wanted
            if isOwnProfile
              a(class='text-xs font-semibold text-[#0857c3] hover:underline' href='/skills') Edit
          if profile.wantSkills.length
            div(class='flex flex-wrap gap-2.5')
              each item in profile.wantSkills
                span(class='px-4 py-1.5 rounded-full bg-[#E1EDFF] text-[#185BCE] text-xs font-semibold tracking-wide inline-flex items-center gap-1.5')
                  span= item.skillName
                  span(class='opacity-75 font-medium')= `(${item.level})`
          else
            p.text-sm.text-slate-400 No wanted skills listed yet.

      section(class='space-y-3' data-purpose='projects-section')
        .flex.items-center.justify-between
          h2(class='text-sm font-bold text-slate-800') Projects
          if isOwnProfile
            a(class='text-xs font-semibold text-[#0056D2] hover:underline' href='/profile/edit') Edit projects
        if profile.projectLinks.length
          div(class='grid grid-cols-1 md:grid-cols-2 gap-4')
            each link in profile.projectLinks
              article(class='bg-white rounded-2xl p-5 shadow-[0_1px_3px_rgba(0,0,0,0.04)] border border-slate-100 flex items-start gap-4' data-purpose='project-card')
                if link.accent === 'emerald'
                  div(class='w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-base shrink-0')= link.iconText
                else
                  div(class='w-12 h-12 rounded-xl bg-blue-50 text-[#0056D2] flex items-center justify-center font-bold font-mono text-base shrink-0')= link.iconText
                .flex-1.min-w-0
                  h3(class='text-sm font-bold text-slate-900 leading-tight truncate')= link.title
                  p(class='text-xs text-slate-500 mt-1 truncate')= link.url
                  div(class='flex flex-wrap gap-1.5 mt-2.5')
                    if link.accent === 'emerald'
                      span(class='text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700')= link.host
                    else
                      span(class='text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700')= link.host
                  .mt-3
                    a(class='inline-flex items-center gap-1 text-xs font-bold text-[#0056D2] hover:underline' href=link.url target='_blank' rel='noopener noreferrer')
                      svg(class='w-3 h-3' fill='none' stroke='currentColor' viewBox='0 0 24 24')
                        path(d='M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14' stroke-linecap='round' stroke-linejoin='round' stroke-width='2.5')
                      span View Project
        else
          div(class='bg-white rounded-2xl p-6 border border-slate-100 text-sm text-slate-400 shadow-[0_1px_3px_rgba(0,0,0,0.04)]') No projects added yet.

      section(class='space-y-3' data-purpose='certificates-section')
        .flex.items-center.justify-between
          h2(class='text-sm font-bold text-slate-800') Certificates
          span(class='text-xs font-semibold text-slate-400')= `${(profile.certificates || []).length} earned`
        if profile.certificates && profile.certificates.length
          div(class='grid grid-cols-1 md:grid-cols-2 gap-4')
            each cert in profile.certificates
              article(class='bg-white rounded-2xl p-5 shadow-[0_1px_3px_rgba(0,0,0,0.04)] border border-slate-100 flex items-start gap-4' data-purpose='certificate-card')
                if cert.accent === 'amber'
                  div(class='w-12 h-12 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center shrink-0')
                    svg(class='w-6 h-6 fill-amber-500' viewBox='0 0 24 24')
                      path(d='M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z')
                else
                  div(class='w-12 h-12 rounded-xl bg-blue-50 text-[#0056D2] flex items-center justify-center shrink-0')
                    svg(class='w-6 h-6 fill-[#0056D2]' viewBox='0 0 24 24')
                      path(d='M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z')
                .flex-1.min-w-0
                  h3(class='text-sm font-bold text-slate-900 leading-tight')= cert.title
                  p(class='text-xs text-slate-500 mt-1')= cert.issuer
                  div(class='mt-4 flex items-center gap-1 text-xs text-[#0056D2] font-semibold')
                    span= cert.issuedLabel
        else
          div(class='bg-white rounded-2xl p-6 border border-slate-100 text-sm text-slate-400 shadow-[0_1px_3px_rgba(0,0,0,0.04)]') Complete a learning session to earn your first verified SkillSwap certificate.

      section(class='bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-4' data-purpose='availability-section')
        .flex.items-center.justify-between
          h2(class='text-[19px] font-bold text-slate-900') Availability
          if isOwnProfile
            a(class='text-xs font-semibold text-[#0857c3] hover:underline' href='/availability') Manage slots
        if profile.availability.length
          div(class='grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3')
            each slot in profile.availability
              div(class='rounded-xl border border-slate-200 bg-[#f8fafc] px-4 py-3 flex items-center justify-between')
                span.text-sm.font-semibold.text-slate-800= slot.dayName
                span(class='text-xs font-bold text-[#0857c3]')= `${slot.startTime} - ${slot.endTime}`
        else
          p.text-sm.text-slate-400 No availability slots configured yet.

      include ../partials/reviews
