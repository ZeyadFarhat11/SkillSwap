aside(class='w-64 bg-white border-r border-slate-100 flex flex-col justify-between shrink-0 sticky top-0 h-screen overflow-y-auto py-7 px-6' data-purpose='sidebar-navigation')
  div
    .px-2.mb-8
      a(class='text-xl font-extrabold tracking-wider text-[#0055D2] uppercase no-underline' href='/admin/users') SKILLSWAP

    .mb-8
      a(class='w-full bg-[#0d59cf] hover:bg-blue-700 text-white font-medium py-2.5 px-4 rounded-lg shadow-sm text-sm transition-colors text-center block' href='/admin/users') Admin Dashboard

    div
      p.text-xs.font-semibold.text-slate-400.tracking-wider.mb-4.px-2 Management
      nav(class='space-y-1.5')
        a(
          class=`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${activeNav === 'admin-users' ? 'font-semibold text-[#0d59cf] bg-blue-50/60' : 'font-medium text-slate-500 hover:text-slate-800 hover:bg-slate-50'}`
          href='/admin/users'
        )
          svg(class='w-5 h-5 stroke-current' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24')
            path(d='M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' stroke-linecap='round' stroke-linejoin='round')
          span Users

        a(
          class=`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${activeNav === 'admin-skills' ? 'font-semibold text-[#0d59cf] bg-blue-50/60' : 'font-medium text-slate-500 hover:text-slate-800 hover:bg-slate-50'}`
          href='/admin/skills'
        )
          svg(class='w-5 h-5 stroke-current' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24')
            path(d='M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' stroke-linecap='round' stroke-linejoin='round')
          span Skills

        a(
          class=`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors ${activeNav === 'admin-reports' ? 'font-semibold text-[#0d59cf] bg-blue-50/60' : 'font-medium text-slate-500 hover:text-slate-800 hover:bg-slate-50'}`
          href='/admin/reports'
        )
          svg(class='w-5 h-5 stroke-current' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24')
            path(d='M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z' stroke-linecap='round' stroke-linejoin='round')
          span Reports

        a(class='flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-500 hover:text-slate-800 hover:bg-slate-50 transition-colors' href='/suggestions')
          svg(class='w-5 h-5 stroke-current' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24')
            path(d='M10 19l-7-7m0 0l7-7m-7 7h18' stroke-linecap='round' stroke-linejoin='round')
          span Back to App

  .pt-6.border-t.border-slate-100
    if currentUser
      p.px-3.pb-2.text-xs.font-semibold.text-slate-500.truncate= currentUser.name
    form(method='POST' action='/logout')
      if csrfToken
        input(type='hidden' name='_csrf' value=csrfToken)
      button(class='w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-semibold text-rose-500 hover:bg-rose-50 transition-colors' type='submit')
        svg(class='w-5 h-5 stroke-[1.8]' fill='none' stroke='currentColor' viewBox='0 0 24 24')
          path(d='M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75' stroke-linecap='round' stroke-linejoin='round')
        span Logout
