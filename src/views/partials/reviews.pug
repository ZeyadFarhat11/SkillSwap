section(class='bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-5' data-purpose='reviews-section')
  .flex.items-center.justify-between
    h2(class='text-[19px] font-bold text-slate-900') Received Reviews
    if averageRating !== null && averageRating !== undefined
      div(class='flex items-center gap-2 bg-[#f0f6ff] px-3 py-1.5 rounded-full')
        span.text-amber-400.text-sm ★
        span(class='text-sm font-bold text-[#0052cc]')= averageRating
        span.text-xs.text-slate-500= `(${(reviews || []).length})`

  if reviews && reviews.length
    div(class='space-y-3.5' data-purpose='review-list')
      each review in reviews
        article(class='bg-[#f8fafc] rounded-xl p-5 border border-slate-100' data-purpose='review-item')
          .flex.items-start.justify-between
            div(class='flex items-center gap-3.5')
              div(class='w-10 h-10 rounded-full bg-[#0052cc] text-white flex items-center justify-center font-bold text-sm shrink-0')= review.reviewerName.charAt(0).toUpperCase()
              div
                h3.text-sm.font-semibold.text-gray-900.leading-snug= review.reviewerName
                p.text-xs.text-gray-400= review.dateLabel
            .flex.items-center.gap-1
              - for (var s = 1; s <= 5; s++)
                if s <= review.stars
                  span.text-sm.text-amber-400 ★
                else
                  span.text-sm.text-gray-300 ★
          if review.comment
            p(class='mt-3.5 text-sm text-gray-800 font-medium')= `"${review.comment}"`
  else
    p.text-sm.text-slate-400 No reviews received yet.
