header.bg-white.border-b.border-slate-100
  div(class='max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between')
    a.flex.items-center.gap-2.no-underline(href='/')
      span.text-xl.font-black.tracking-wide.uppercase
        span.text-brand-blue Skill
        span.text-brand-green Swap
    nav.flex.items-center.gap-4.text-sm.font-medium
      if currentUser
        a(class='text-slate-600 hover:text-brand-blue' href='/suggestions') Suggestions
        a(class='text-slate-600 hover:text-brand-blue' href='/requests') Requests
        a(class='text-slate-600 hover:text-brand-blue' href='/sessions') Sessions
        a(class='text-slate-600 hover:text-brand-blue' href='/messages') Messages
        a(class='text-slate-600 hover:text-brand-blue' href='/points') Points
        a(class='text-slate-600 hover:text-brand-blue' href='/profile')= currentUser.name
        if currentUser.role === 'admin'
          a.text-brand-blue.font-semibold(href='/admin/users') Admin
        form.inline(method='POST' action='/logout')
          if csrfToken
            input(type='hidden' name='_csrf' value=csrfToken)
          button(class='text-rose-600 hover:text-rose-700 font-semibold' type='submit') Logout
      else
        a(class='text-slate-600 hover:text-brand-blue' href='/login') Log in
        a(class='inline-flex items-center px-4 py-2 rounded-full bg-brand-blue text-white text-sm font-semibold hover:bg-brand-blue-hover transition-colors' href='/register') Get started
