header(class='h-20 bg-white border-b border-slate-100 flex items-center justify-between px-8 lg:px-10 sticky top-0 z-10' data-purpose='topbar')
  form(class='relative w-72 sm:w-80' method='GET' action=(searchAction || '/admin/users'))
    div(class='absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400')
      svg(class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24')
        path(d='M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z' stroke-linecap='round' stroke-linejoin='round' stroke-width='2')
    input(
      class='w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:bg-white'
      type='text'
      name='q'
      placeholder='Search here'
      value=(filters && filters.q ? filters.q : '')
      data-table-search-target=(searchTableId || null)
    )

  div(class='flex items-center space-x-5')
    a(
      aria-label='Notifications'
      class='p-2 text-slate-400 hover:text-slate-600 bg-slate-50 rounded-full border border-slate-100 transition'
      href='/notifications'
    )
      svg(class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24')
        path(d='M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9' stroke-linecap='round' stroke-linejoin='round' stroke-width='2')

    a(
      aria-label='Open User App'
      title='Switch to User App'
      class='p-2 text-slate-400 hover:text-slate-600 bg-slate-50 rounded-full border border-slate-100 transition'
      href='/suggestions'
    )
      svg(class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24')
        path(d='M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4' stroke-linecap='round' stroke-linejoin='round' stroke-width='2')

    div(class='flex items-center space-x-3')
      if currentUser && currentUser.avatarPath
        img(alt=currentUser.name class='w-10 h-10 rounded-full object-cover border border-slate-200' src=`/${currentUser.avatarPath}`)
      else
        div(class='w-10 h-10 rounded-full bg-blue-50 text-[#0d59cf] font-bold text-xs flex items-center justify-center border border-blue-100')
          = currentUser && currentUser.name ? currentUser.name.slice(0, 2).toUpperCase() : 'AD'
      div(class='text-left text-xs leading-snug hidden sm:block')
        p(class='font-bold text-slate-800 text-sm')= currentUser ? currentUser.name : 'Administrator'
        p(class='text-blue-600 font-medium') Administrator
