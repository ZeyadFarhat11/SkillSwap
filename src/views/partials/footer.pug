- var pFooter = platformSettings || { platformName: 'SkillSwap', platformEmail: 'support@skillswap.com' }
footer.mt-auto.border-t.border-slate-200.bg-white.py-6
  div(class='max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-500')
    p= `${pFooter.platformName} — Peer-to-peer skill exchange`
    .flex.items-center.gap-4
      if pFooter.platformEmail
        span= pFooter.platformEmail
      a(class='hover:text-slate-700' href='/reports') Report an issue
