aside(class='w-64 bg-white border-r border-slate-100 flex flex-col justify-between shrink-0 min-h-screen py-6 px-6 select-none' data-purpose='sidebar-navigation')
  div
    .px-2.mb-8
      a(class='text-2xl font-black tracking-wide text-[#0058b8] uppercase no-underline' href='/suggestions') SKILLSWAP

    .space-y-6
      div
        span(class='px-3 text-[11px] font-bold tracking-wider text-slate-400 uppercase') OVERVIEW
        nav.mt-3.space-y-1(aria-label='Main Navigation')
          a(
            class=`flex items-center gap-3.5 px-3 py-2.5 rounded-lg text-sm transition-colors ${activeNav === 'suggestions' ? 'font-semibold text-[#0058b8] bg-blue-50/60' : 'font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50'}`
            href='/suggestions'
          )
            svg(class='w-5 h-5 stroke-[1.8]' fill='none' stroke='currentColor' viewBox='0 0 24 24')
              path(d='M3 10.25L12 3l9 7.25M4.5 9v11.25a.75.75 0 00.75.75H9.75v-6a.75.75 0 01.75-.75h3a.75.75 0 01.75.75v6h4.5a.75.75 0 00.75-.75V9' stroke-linecap='round' stroke-linejoin='round')
            span Home

          a(
            class=`flex items-center gap-3.5 px-3 py-2.5 rounded-lg text-sm transition-colors ${activeNav === 'requests' ? 'font-semibold text-[#0058b8] bg-blue-50/60' : 'font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50'}`
            href='/requests'
          )
            svg(class='w-5 h-5 stroke-[1.8]' fill='none' stroke='currentColor' viewBox='0 0 24 24')
              path(d='M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3' stroke-linecap='round' stroke-linejoin='round')
            span Swap

          a(
            class=`flex items-center gap-3.5 px-3 py-2.5 rounded-lg text-sm transition-colors ${activeNav === 'messages' ? 'font-semibold text-[#0058b8] bg-blue-50/60' : 'font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50'}`
            href='/messages'
          )
            svg(class='w-5 h-5 stroke-[1.8]' fill='none' stroke='currentColor' viewBox='0 0 24 24')
              path(d='M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5' stroke-linecap='round' stroke-linejoin='round')
            span Chat

          a(
            class=`flex items-center gap-3.5 px-3 py-2.5 rounded-lg text-sm transition-colors ${activeNav === 'sessions' ? 'font-semibold text-[#0058b8] bg-blue-50/60' : 'font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50'}`
            href='/sessions'
          )
            svg(class='w-5 h-5 stroke-[1.8]' fill='none' stroke='currentColor' viewBox='0 0 24 24')
              path(d='M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z' stroke-linecap='round' stroke-linejoin='round')
            span Session

          a(
            class=`flex items-center gap-3.5 px-3 py-2.5 rounded-lg text-sm transition-colors ${activeNav === 'points' ? 'font-semibold text-[#0058b8] bg-blue-50/60' : 'font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50'}`
            href='/points'
          )
            svg(class='w-5 h-5 stroke-[1.8]' fill='none' stroke='currentColor' viewBox='0 0 24 24')
              path(d='M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z' stroke-linecap='round' stroke-linejoin='round')
            span Points Wallet

          a(
            class=`flex items-center gap-3.5 px-3 py-2.5 rounded-lg text-sm transition-colors ${activeNav === 'profile' ? 'font-semibold text-[#0058b8] bg-blue-50/60' : 'font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50'}`
            href='/profile'
          )
            svg(class='w-5 h-5 stroke-[1.8]' fill='none' stroke='currentColor' viewBox='0 0 24 24')
              path(d='M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z' stroke-linecap='round' stroke-linejoin='round')
            span Profile

          a(
            class=`flex items-center gap-3.5 px-3 py-2.5 rounded-lg text-sm transition-colors ${activeNav === 'reports' ? 'font-semibold text-[#0058b8] bg-blue-50/60' : 'font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50'}`
            href='/reports'
          )
            svg(class='w-5 h-5 stroke-[1.8]' fill='none' stroke='currentColor' viewBox='0 0 24 24')
              path(d='M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z' stroke-linecap='round' stroke-linejoin='round')
            span Reports

          if currentUser && currentUser.role === 'admin'
            a(class='flex items-center gap-3.5 px-3 py-2.5 rounded-lg text-sm font-semibold text-[#0055D2] hover:bg-blue-50/60 transition-colors' href='/admin/users')
              svg(class='w-5 h-5 stroke-[1.8]' fill='none' stroke='currentColor' viewBox='0 0 24 24')
                path(d='M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z' stroke-linecap='round' stroke-linejoin='round')
              span Admin

  .pt-6.border-t.border-slate-100
    span(class='px-3 text-[11px] font-bold tracking-wider text-slate-400 uppercase') SETTINGS
    .mt-2
      if currentUser
        p.px-3.pb-2.text-xs.font-semibold.text-slate-500.truncate= currentUser.name
      form(method='POST' action='/logout')
        if csrfToken
          input(type='hidden' name='_csrf' value=csrfToken)
        button(class='w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-semibold text-rose-500 hover:bg-rose-50 transition-colors' type='submit')
          svg(class='w-5 h-5 stroke-[1.8]' fill='none' stroke='currentColor' viewBox='0 0 24 24')
            path(d='M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75' stroke-linecap='round' stroke-linejoin='round')
          span Logout
